[app]
title = ApexTitan
package.name = apextitan
package.domain = org.test
source.dir = .
source.include_exts = py,png,jpg,ttf,wav,mp3,ogg
version = 0.1
requirements = python3,pygame
orientation = portrait
fullscreen = 1
android.archs = arm64-v8a, armeabi-v7a
android.allow_backup = True

[buildozer]
log_level = 2
warn_on_root = 1
